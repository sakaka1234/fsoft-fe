# Copy to `.env` (the name Compose reads) before `docker compose up --build`.
#
# Both values are compiled into the browser bundle by `next build`. They are
# NOT read when the container starts, so editing them means rebuilding the
# image, not restarting it.

# Backend base URL, including the /fsoft path segment.
NEXT_PUBLIC_API_BASE_URL=https://fsoft-project-production.up.railway.app/fsoft

# Google OAuth client id. The redirect URI is derived in the browser as
# <origin>/callback, so whatever origin you serve the container on must be
# registered in the Google Console or sign-in fails with redirect_uri_mismatch.
# For a local container on port 4000 that is http://localhost:4000/callback.
# Leave empty to build without Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Host port to publish on. The container always listens on 4000 internally.
PORT=4000
