# Backend base URL from docs/api-docs.json.
# Copy to .env.local and point at a local backend when you run one.
NEXT_PUBLIC_API_BASE_URL=https://fsoft-project-production.up.railway.app/fsoft

# Google OAuth client id. The redirect URI is derived as <origin>/callback and
# must be registered in the Google Console. The dev server and the Docker
# container both serve on port 4000, so http://localhost:4000/callback needs to
# be registered, along with the production origin before deploying.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
