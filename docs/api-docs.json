  "components": {
    "schemas": {
      "TagRequest": {
        "type": "object",
        "properties": { "name": { "type": "string" } },
        "required": ["name"]
      },
      "ApiResponseTagResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/TagResponse" }
        }
      },
      "TagResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" }
        }
      },
      "DeckUpdateRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "parentDeckId": { "type": "integer", "format": "int64" },
          "sourceLanguage": { "type": "string" },
          "targetLanguage": { "type": "string" },
          "visibility": {
            "type": "string",
            "enum": ["PUBLIC", "PRIVATE", "SHARED"]
          },
          "tagIds": {
            "type": "array",
            "items": { "type": "integer", "format": "int64" },
            "uniqueItems": true
          },
          "official": { "type": "boolean" }
        },
        "required": ["sourceLanguage", "targetLanguage", "title", "visibility"]
      },
      "ApiResponseDeckResponse": {
        "type": "object",
